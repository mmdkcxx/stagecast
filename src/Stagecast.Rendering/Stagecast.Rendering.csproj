<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <RootNamespace>Stagecast.Rendering</RootNamespace>
    <!-- The WebView2 package ships a WPF assembly that needs the WPF reference set to resolve WindowsBase. -->
    <UseWPF>true</UseWPF>
    <!-- GraphicsCaptureSession.MinUpdateInterval lives in a newer Windows SDK projection than the target version. -->
    <WindowsSdkPackageVersion>10.0.26100.54</WindowsSdkPackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Stagecast.Core\Stagecast.Core.csproj" />
  </ItemGroup>

</Project>
