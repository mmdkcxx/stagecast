<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Stagecast.Pattern</RootNamespace>
    <AssemblyName>StagecastPattern</AssemblyName>
    <Version>1.0.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\Stagecast.App\stagecast.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Vortice.MediaFoundation" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- The same fonts as Stagecast (Barlow, IBM Plex Mono; SIL Open Font License). -->
    <Resource Include="..\Stagecast.App\Fonts\*.ttf" Link="Fonts\%(Filename)%(Extension)" />
    <None Include="..\Stagecast.App\Fonts\*-OFL.txt" CopyToOutputDirectory="PreserveNewest" Link="licenses\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Stagecast.Core\Stagecast.Core.csproj" />
  </ItemGroup>

</Project>
