<Window x:Class="Stagecast.Pattern.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stagecast Pattern" Width="1180" Height="760" MinWidth="900" MinHeight="620"
        Background="{StaticResource Bg}" FontFamily="{StaticResource FontBody}" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16" x:Name="Controls">
                    <TextBlock Style="{StaticResource Section}" Text="RESOLUSI (KETIK)"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Hint}" Text="Lebar (piksel)"/>
                            <TextBox x:Name="WidthBox" Style="{StaticResource Field}" TextChanged="OnFieldChanged"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource Hint}" Text="Tinggi (piksel)"/>
                            <TextBox x:Name="HeightBox" Style="{StaticResource Field}" TextChanged="OnFieldChanged"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="SizeError" Style="{StaticResource Error}" Margin="0,4,0,0"/>

                    <TextBlock Style="{StaticResource Section}" Text="WAKTU" Margin="0,18,0,6"/>
                    <TextBlock Style="{StaticResource Hint}" Text="Frame per detik"/>
                    <StackPanel Orientation="Horizontal" x:Name="FpsRow"/>
                    <TextBlock Style="{StaticResource Hint}" Text="Durasi (detik)" Margin="0,10,0,3"/>
                    <TextBox x:Name="SecondsBox" Style="{StaticResource Field}" TextChanged="OnFieldChanged"/>
                    <TextBlock x:Name="SecondsError" Style="{StaticResource Error}" Margin="0,4,0,0"/>

                    <TextBlock Style="{StaticResource Section}" Text="TEKS" Margin="0,18,0,6"/>
                    <TextBlock Style="{StaticResource Hint}" Text="Judul (ganti baris &quot;STAGECAST TEST PATTERN&quot;)"/>
                    <TextBox x:Name="TitleBox" Style="{StaticResource Field}" MaxLength="40" TextChanged="OnFieldChanged"/>
                    <TextBlock Style="{StaticResource Hint}" Text="Baris kedua (boleh kosong)" Margin="0,10,0,3"/>
                    <TextBox x:Name="SubtitleBox" Style="{StaticResource Field}" MaxLength="40" TextChanged="OnFieldChanged"/>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="Huruf besar otomatis. Tanda yang tidak ada di font piksel Stagecast tampil sebagai ?"/>

                    <TextBlock Style="{StaticResource Section}" Text="SUARA BEEP" Margin="0,18,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Hint}" Text="Nada (Hz)"/>
                            <TextBox x:Name="ToneBox" Style="{StaticResource Field}" TextChanged="OnFieldChanged"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource Hint}" Text="Level (dBFS)"/>
                            <TextBox x:Name="LevelBox" Style="{StaticResource Field}" TextChanged="OnFieldChanged"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="SoundError" Style="{StaticResource Error}" Margin="0,4,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="0" Grid.Column="1" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Background="#050504" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="3" Padding="8">
                <Image x:Name="Preview" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>
            <WrapPanel Grid.Row="1" Margin="0,10,0,0">
                <TextBlock x:Name="MetaSize" Style="{StaticResource Mono}" Margin="0,0,18,0"/>
                <TextBlock x:Name="MetaRatio" Style="{StaticResource Mono}" Margin="0,0,18,0"/>
                <TextBlock x:Name="MetaFrames" Style="{StaticResource Mono}" Margin="0,0,18,0"/>
                <TextBlock x:Name="MetaBytes" Style="{StaticResource Mono}"/>
            </WrapPanel>
        </Grid>

        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{StaticResource Bg}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock x:Name="FileName" Style="{StaticResource Mono}" Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Style="{StaticResource Mono}" Text="H.264 + AAC 192 kbit/s, 48 kHz stereo, tempat simpan dipilih saat Render" Margin="0,2,0,0"/>
                </StackPanel>
                <Button x:Name="RenderButton" Grid.Column="1" Style="{StaticResource ActionButton}" Content="Render MP4" Click="OnRenderClick"/>
                <ProgressBar x:Name="Bar" Grid.Row="1" Grid.ColumnSpan="2" Height="6" Margin="0,10,0,0" Minimum="0" Maximum="1"
                             Background="{StaticResource Line}" Foreground="{StaticResource Ok}" BorderThickness="0"/>
                <TextBlock x:Name="StatusText" Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource Mono}" Margin="0,6,0,0" Text="Siap."/>
            </Grid>
        </Border>
    </Grid>
</Window>
