<Window x:Class="Stagecast.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Stagecast.App"
        Title="Stagecast" Width="1280" Height="760" MinWidth="900" MinHeight="560"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <DockPanel Margin="16,0">
                <TextBlock Text="STAGECAST" Foreground="{StaticResource Text}" FontFamily="Segoe UI" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,24,0"/>
                <TextBlock x:Name="VersionText" DockPanel.Dock="Right" Foreground="{StaticResource Muted}" FontFamily="Consolas" FontSize="13" VerticalAlignment="Center" Margin="16,0,0,0"/>
                <TextBox x:Name="UrlBox" Style="{StaticResource Field}" VerticalAlignment="Center" ToolTip="Alamat halaman. Tekan Enter untuk memuat." KeyDown="OnUrlKeyDown"/>
            </DockPanel>
        </Border>

        <Border x:Name="Banner" Grid.Row="1" Visibility="Collapsed" Background="#2A2415" BorderBrush="{StaticResource Warn}" BorderThickness="0,0,0,1" Padding="16,10">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Terapkan" Style="{StaticResource ActionButton}" Margin="8,0,0,0" Click="OnBannerApply"/>
                <Button DockPanel.Dock="Right" Content="Batal" Style="{StaticResource ActionButton}" Click="OnBannerCancel"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="BannerTitle" Foreground="{StaticResource Warn}" FontFamily="Segoe UI" FontSize="14" FontWeight="Bold"/>
                    <TextBlock x:Name="BannerDetail" Foreground="{StaticResource Text}" FontFamily="Consolas" FontSize="13" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="SideColumn" Width="300"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="False">
                    <Button x:Name="BackButton" Content="Kembali" Style="{StaticResource ToolButton}" Click="OnBack" ToolTip="Halaman sebelumnya"/>
                    <Button x:Name="ForwardButton" Content="Maju" Style="{StaticResource ToolButton}" Click="OnForward" ToolTip="Halaman berikutnya"/>
                    <Button x:Name="ReloadButton" Content="Muat ulang" Style="{StaticResource ToolButton}" Click="OnReload"/>
                    <Border Width="1" Background="{StaticResource Line}" Margin="6,2,12,2"/>
                    <ToggleButton x:Name="FitButton" Content="Fit" Style="{StaticResource ToolToggle}" Click="OnFit" ToolTip="Seluruh halaman muat di preview"/>
                    <ToggleButton x:Name="ActualButton" Content="100%" Style="{StaticResource ToolToggle}" Click="OnActual" ToolTip="Ukuran asli; geser dengan seret atau Space + seret"/>
                    <Button x:Name="MoreButton" Content="···" Style="{StaticResource ToolButton}" Click="OnMore" ToolTip="Zoom halaman"/>
                    <TextBlock x:Name="ZoomLabel" Foreground="{StaticResource Warn}" FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="2,0,0,0"
                               ToolTip="Zoom halaman mengubah isi halaman yang keluar, bukan hanya preview"/>
                    <Button x:Name="DetachButton" DockPanel.Dock="Right" Content="Jendela terpisah" Style="{StaticResource ToolButton}" Margin="0" Click="OnDetach" ToolTip="Pindahkan preview ke jendela sendiri (untuk monitor lain)"/>
                    <ToggleButton x:Name="EnlargeButton" DockPanel.Dock="Right" Content="Perbesar" Style="{StaticResource ToolToggle}" Click="OnEnlarge" ToolTip="Sembunyikan panel kanan"/>
                    <ToggleButton x:Name="InteractButton" DockPanel.Dock="Right" Content="Interaksi" Style="{StaticResource ToolToggle}" Click="OnInteract" ToolTip="Teruskan klik, gulir, dan ketik ke halaman. Esc melepas keyboard dari halaman."/>
                </DockPanel>

                <Border x:Name="PreviewHost" Grid.Row="1" Background="Black" BorderBrush="{StaticResource Line}" BorderThickness="1">
                    <local:PagePreview x:Name="PagePreviewView"/>
                </Border>
                <TextBlock x:Name="DetachedNote" Grid.Row="1" Text="Preview ada di jendela terpisah. Tutup jendelanya untuk mengembalikan ke sini." Visibility="Collapsed"
                           Foreground="{StaticResource Muted}" FontFamily="Segoe UI" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>

            <Border x:Name="SidePanel" Grid.Column="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16">
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="+ Tab" Style="{StaticResource ToolButton}" Margin="0" Click="OnAddTab" ToolTip="Tab baru (Ctrl+T)"/>
                        <TextBlock Text="TAB" Style="{StaticResource Label}" Margin="0" VerticalAlignment="Center"/>
                    </DockPanel>
                    <StackPanel x:Name="TabListPanel"/>
                    <TextBlock x:Name="TabError" Foreground="{StaticResource Warn}" FontFamily="Segoe UI" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    <Border Height="1" Background="{StaticResource Line}" Margin="0,12,0,16"/>

                    <TextBlock Text="RESOLUSI" Style="{StaticResource Label}"/>
                    <Button x:Name="PresetButton" Style="{StaticResource ToolButton}" Margin="0,0,0,8" HorizontalContentAlignment="Left" Click="OnPresetMenu" ToolTip="Pilih resolusi tersimpan"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="WidthBox" Style="{StaticResource Field}" Grid.Column="0" ToolTip="Lebar dalam piksel (100-8192)" KeyDown="OnResolutionKeyDown"/>
                        <TextBlock Grid.Column="1" Text="×" Foreground="{StaticResource Muted}" FontSize="16" VerticalAlignment="Center" Margin="8,0"/>
                        <TextBox x:Name="HeightBox" Style="{StaticResource Field}" Grid.Column="2" ToolTip="Tinggi dalam piksel (100-8192)" KeyDown="OnResolutionKeyDown"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="ApplyButton" Content="Terapkan" Style="{StaticResource ActionButton}" Click="OnApplyResolution"/>
                        <Button Content="Simpan preset" Style="{StaticResource ToolButton}" Margin="8,0,0,0" Click="OnSavePreset" ToolTip="Simpan resolusi yang sedang dipakai sebagai preset"/>
                        <Button Content="Kelola" Style="{StaticResource ToolButton}" Margin="0" Click="OnManagePresets"/>
                    </StackPanel>
                    <Border x:Name="PresetPanel" Visibility="Collapsed" Margin="0,10,0,0" Padding="10" Background="{StaticResource Raised}" BorderBrush="{StaticResource LineStrong}" BorderThickness="1">
                        <StackPanel x:Name="PresetPanelBody"/>
                    </Border>
                    <TextBlock x:Name="ResolutionError" Foreground="{StaticResource Warn}" FontFamily="Segoe UI" FontSize="13" TextWrapping="Wrap" Margin="0,8,0,0"/>

                    <TextBlock Text="FPS" Style="{StaticResource Label}" Margin="0,24,0,6"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="Fps30" Content="30" GroupName="fps" Style="{StaticResource Choice}" Checked="OnFpsChecked"/>
                        <RadioButton x:Name="Fps60" Content="60" GroupName="fps" Style="{StaticResource Choice}" Checked="OnFpsChecked"/>
                    </StackPanel>

                    <TextBlock Text="STATISTIK" Style="{StaticResource Label}" Margin="0,24,0,6"/>
                    <TextBlock x:Name="StatsText" Foreground="{StaticResource Text}" FontFamily="Consolas" FontSize="12" LineHeight="18"/>

                    <CheckBox x:Name="LiveSimBox" Content="Uji: anggap ada output yang nyala" Foreground="{StaticResource Muted}" FontFamily="Segoe UI" FontSize="12" Margin="0,24,0,0"
                              ToolTip="Sementara, sampai output ada di A4: memperlihatkan spanduk konfirmasi ubah resolusi/FPS"/>
                </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="16,8">
            <TextBlock x:Name="StatusText" Foreground="{StaticResource Muted}" FontFamily="Consolas" FontSize="12"/>
        </Border>
    </Grid>
</Window>
