<Window x:Class="Stagecast.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stagecast" Width="1280" Height="760" MinWidth="900" MinHeight="560"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <DockPanel Margin="16,0">
                <TextBlock Text="STAGECAST" Foreground="{StaticResource Text}" FontFamily="Segoe UI" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,24,0"/>
                <TextBlock x:Name="VersionText" DockPanel.Dock="Right" Foreground="{StaticResource Muted}" FontFamily="Consolas" FontSize="13" VerticalAlignment="Center" Margin="16,0,0,0"/>
                <TextBox x:Name="UrlBox" Style="{StaticResource Field}" VerticalAlignment="Center" ToolTip="Alamat halaman. Tekan Enter untuk memuat." KeyDown="OnUrlKeyDown"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Margin="16" Background="Black" BorderBrush="{StaticResource Line}" BorderThickness="1">
                <Image x:Name="Preview" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
                <StackPanel Margin="16">
                    <TextBlock Text="RESOLUSI" Style="{StaticResource Label}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="WidthBox" Style="{StaticResource Field}" Grid.Column="0" ToolTip="Lebar dalam piksel (100-8192)" KeyDown="OnResolutionKeyDown"/>
                        <TextBlock Grid.Column="1" Text="×" Foreground="{StaticResource Muted}" FontSize="16" VerticalAlignment="Center" Margin="8,0"/>
                        <TextBox x:Name="HeightBox" Style="{StaticResource Field}" Grid.Column="2" ToolTip="Tinggi dalam piksel (100-8192)" KeyDown="OnResolutionKeyDown"/>
                    </Grid>
                    <Button x:Name="ApplyButton" Content="Terapkan" Style="{StaticResource ActionButton}" Margin="0,10,0,0" HorizontalAlignment="Left" Click="OnApplyResolution"/>
                    <TextBlock x:Name="ResolutionError" Foreground="{StaticResource Warn}" FontFamily="Segoe UI" FontSize="13" TextWrapping="Wrap" Margin="0,8,0,0"/>

                    <TextBlock Text="FPS" Style="{StaticResource Label}" Margin="0,24,0,6"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="Fps30" Content="30" GroupName="fps" Style="{StaticResource Choice}" Checked="OnFpsChecked"/>
                        <RadioButton x:Name="Fps60" Content="60" GroupName="fps" Style="{StaticResource Choice}" Checked="OnFpsChecked"/>
                    </StackPanel>

                    <TextBlock Text="STATISTIK" Style="{StaticResource Label}" Margin="0,24,0,6"/>
                    <TextBlock x:Name="StatsText" Foreground="{StaticResource Text}" FontFamily="Consolas" FontSize="12" LineHeight="18"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="16,8">
            <TextBlock x:Name="StatusText" Foreground="{StaticResource Muted}" FontFamily="Consolas" FontSize="12"/>
        </Border>
    </Grid>
</Window>
