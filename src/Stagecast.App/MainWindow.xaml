<Window x:Class="Stagecast.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stagecast" Width="1100" Height="680" MinWidth="720" MinHeight="460"
        Background="#0C0B09" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#151411" BorderBrush="#34332F" BorderThickness="0,0,0,1">
            <DockPanel Margin="16,0">
                <TextBlock Text="STAGECAST" Foreground="#F0EEEA" FontFamily="Segoe UI" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock x:Name="VersionText" DockPanel.Dock="Right" Foreground="#AEAAA4" FontFamily="Consolas" FontSize="13" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock x:Name="ResolutionText" Foreground="#F0EEEA" FontFamily="Consolas" FontSize="44" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock x:Name="FpsText" Foreground="#AEAAA4" FontFamily="Consolas" FontSize="20" Margin="0,8,0,0" HorizontalAlignment="Center"/>
            <TextBlock x:Name="ConfigText" Foreground="#AEAAA4" FontFamily="Segoe UI" FontSize="14" Margin="0,28,0,0" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="700" TextAlignment="Center"/>
        </StackPanel>

        <Border Grid.Row="2" Background="#151411" BorderBrush="#34332F" BorderThickness="0,1,0,0" Padding="16,8">
            <TextBlock x:Name="PathText" Foreground="#AEAAA4" FontFamily="Consolas" FontSize="12"/>
        </Border>
    </Grid>
</Window>
