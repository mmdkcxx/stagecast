<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <WindowsSdkPackageVersion>10.0.26100.54</WindowsSdkPackageVersion>
    <UseWPF>true</UseWPF>
    <RootNamespace>Stagecast.App</RootNamespace>
    <AssemblyName>Stagecast</AssemblyName>
    <Version>0.1.6</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>stagecast.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Serilog" Version="4.0.2" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="stagecast.ico" />
    <Resource Include="Fonts\*.ttf" />
    <None Include="Fonts\*-OFL.txt" CopyToOutputDirectory="PreserveNewest" Link="licenses\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- Native VMX codec used by the OMT output (libomtnet.dll is copied through the Rendering reference). -->
    <Content Include="..\..\third_party\omt\libvmx.dll" Link="libvmx.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Stagecast.Core\Stagecast.Core.csproj" />
    <ProjectReference Include="..\Stagecast.Rendering\Stagecast.Rendering.csproj" />
  </ItemGroup>

</Project>
