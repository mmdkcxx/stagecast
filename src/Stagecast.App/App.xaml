<Application x:Class="Stagecast.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="Bg" Color="#0C0B09"/>
        <SolidColorBrush x:Key="Panel" Color="#151411"/>
        <SolidColorBrush x:Key="Raised" Color="#1F1E1B"/>
        <SolidColorBrush x:Key="Line" Color="#34332F"/>
        <SolidColorBrush x:Key="LineStrong" Color="#4A4743"/>
        <SolidColorBrush x:Key="Text" Color="#F0EEEA"/>
        <SolidColorBrush x:Key="Muted" Color="#AEAAA4"/>
        <SolidColorBrush x:Key="Warn" Color="#F7C243"/>
        <SolidColorBrush x:Key="Ok" Color="#56DC85"/>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource Raised}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineStrong}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Text}"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Raised}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineStrong}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,7"/>
        </Style>
        <Style x:Key="Choice" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
        </Style>
    </Application.Resources>
</Application>
