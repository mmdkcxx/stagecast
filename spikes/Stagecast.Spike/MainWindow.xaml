<Window x:Class="Stagecast.Spike.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Stagecast spike S1" Width="1280" Height="720"
        Background="#0C0B09" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel x:Name="Bar" Grid.Row="0" Margin="8" Visibility="Collapsed">
            <Button x:Name="GoButton" DockPanel.Dock="Right" Content="Go" Width="60" Margin="8,0,0,0"/>
            <TextBox x:Name="UrlBox" FontFamily="Consolas" FontSize="14"/>
        </DockPanel>
        <wv2:WebView2 x:Name="Web" Grid.Row="1"/>
        <Image x:Name="Preview" Grid.Row="1" Stretch="Uniform" RenderOptions.BitmapScalingMode="LowQuality"/>
        <TextBlock x:Name="Status" Grid.Row="2" Margin="12,8" Foreground="#AEAAA4"
                   FontFamily="Consolas" FontSize="13" Text="starting..."/>
    </Grid>
</Window>
