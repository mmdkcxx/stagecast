<Window x:Class="Stagecast.Spike.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Stagecast spike S1" Width="1280" Height="720"
        Background="#0C0B09" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <wv2:WebView2 x:Name="Web" Grid.Row="0"/>
        <TextBlock x:Name="Status" Grid.Row="1" Margin="12,8" Foreground="#AEAAA4"
                   FontFamily="Consolas" FontSize="13" Text="starting..."/>
    </Grid>
</Window>
