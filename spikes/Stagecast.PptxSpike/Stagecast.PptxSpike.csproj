<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Stagecast.PptxSpike</RootNamespace>
    <!-- GraphicsCaptureSession.IsBorderRequired lives in a newer Windows SDK projection than the target version. -->
    <WindowsSdkPackageVersion>10.0.26100.54</WindowsSdkPackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- The audio spike uses the app's own process loopback capture, linked so it is the code that will ship. -->
    <Compile Include="..\..\src\Stagecast.Rendering\Audio\ProcessLoopbackCapture.cs" Link="ProcessLoopbackCapture.cs" />
    <ProjectReference Include="..\..\src\Stagecast.Core\Stagecast.Core.csproj" />
  </ItemGroup>

</Project>
